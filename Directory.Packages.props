<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <MauiPackageVersion>10.0.110</MauiPackageVersion>
    <!-- Version of the locally packed PJAnimation package consumed by samples when UsePJAnimationPackage=true -->
    <PJAnimationPackageVersion>0.1.0-preview.1</PJAnimationPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="PJAnimation" Version="$(PJAnimationPackageVersion)" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Microsoft.Maui.Controls" Version="$(MauiPackageVersion)" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
