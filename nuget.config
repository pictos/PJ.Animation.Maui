<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Local output of `dotnet pack src/PJAnimation -c Release -o artifacts`, used by -p:UsePJAnimationPackage=true -->
    <add key="pjanimation-local" value="artifacts" />
  </packageSources>
</configuration>
